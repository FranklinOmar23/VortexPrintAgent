{
  "name": "vortex-print-agent",
  "productName": "Vortex Print Agent",
  "version": "1.4.0",
  "description": "Agente local de impresión para el POS Vortex -- reemplaza a QZ Tray. Corre en la bandeja del sistema, recibe tickets por WebSocket y los imprime directo (sin diálogo) en la impresora que elijas.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis",
    "test": "node --test test/balanzaParser.test.js"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "selfsigned": "^2.4.1",
    "serialport": "^12.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.vortex.printagent",
    "productName": "Vortex Print Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "VortexPrintAgent-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Vortex Print Agent",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Vortex Print Agent",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    }
  }
}
